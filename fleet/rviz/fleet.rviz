Panels:
  - Class: rviz_common/Displays
    Name: Displays
    Tree Height: 700
  - Class: rviz_common/Views
    Name: Views
Visualization Manager:
  Class: ""
  Displays:
    - Class: rviz_default_plugins/Grid
      Name: Grid
      Enabled: true
      Cell Size: 1
      Plane Cell Count: 40
    - Class: rviz_default_plugins/MarkerArray
      Name: World (walls)
      Enabled: true
      Namespaces: {}
      Topic:
        Value: /layers/l_2d
        Depth: 5
        Durability Policy: Volatile
        Reliability Policy: Reliable
    - Class: rviz_default_plugins/MarkerArray
      Name: Robot bodies (ground truth)
      Enabled: true
      Namespaces: {}
      Topic:
        Value: /models/m_robot1
        Depth: 5
        Durability Policy: Volatile
        Reliability Policy: Reliable
    - Class: rviz_default_plugins/MarkerArray
      Name: Robot bodies 2
      Enabled: true
      Namespaces: {}
      Topic:
        Value: /models/m_robot2
        Depth: 5
        Durability Policy: Volatile
        Reliability Policy: Reliable
    - Class: rviz_default_plugins/MarkerArray
      Name: Robot bodies 3
      Enabled: true
      Namespaces: {}
      Topic:
        Value: /models/m_robot3
        Depth: 5
        Durability Policy: Volatile
        Reliability Policy: Reliable
    - Class: rviz_default_plugins/Map
      Name: robot1 map
      Enabled: true
      Color Scheme: map
      Alpha: 0.4
      Topic:
        Value: /robot1/map
        Depth: 1
        Durability Policy: Transient Local
        Reliability Policy: Reliable
    - Class: rviz_default_plugins/Map
      Name: robot2 map
      Enabled: false
      Color Scheme: map
      Alpha: 0.4
      Topic:
        Value: /robot2/map
        Depth: 1
        Durability Policy: Transient Local
        Reliability Policy: Reliable
    - Class: rviz_default_plugins/Map
      Name: robot3 map
      Enabled: false
      Color Scheme: map
      Alpha: 0.4
      Topic:
        Value: /robot3/map
        Depth: 1
        Durability Policy: Transient Local
        Reliability Policy: Reliable
    - Class: rviz_default_plugins/LaserScan
      Name: robot1 scan
      Enabled: true
      Color Transformer: FlatColor
      Color: 255; 60; 60
      Size (m): 0.05
      Style: Flat Squares
      Topic:
        Value: /robot1/scan
        Depth: 5
        Durability Policy: Volatile
        Reliability Policy: Reliable
    - Class: rviz_default_plugins/LaserScan
      Name: robot2 scan
      Enabled: true
      Color Transformer: FlatColor
      Color: 60; 255; 60
      Size (m): 0.05
      Style: Flat Squares
      Topic:
        Value: /robot2/scan
        Depth: 5
        Durability Policy: Volatile
        Reliability Policy: Reliable
    - Class: rviz_default_plugins/LaserScan
      Name: robot3 scan
      Enabled: true
      Color Transformer: FlatColor
      Color: 80; 120; 255
      Size (m): 0.05
      Style: Flat Squares
      Topic:
        Value: /robot3/scan
        Depth: 5
        Durability Policy: Volatile
        Reliability Policy: Reliable
    - Class: rviz_default_plugins/Path
      Name: robot1 plan
      Enabled: true
      Color: 255; 60; 60
      Topic:
        Value: /robot1/plan
        Depth: 5
        Durability Policy: Volatile
        Reliability Policy: Reliable
    - Class: rviz_default_plugins/Path
      Name: robot2 plan
      Enabled: true
      Color: 60; 255; 60
      Topic:
        Value: /robot2/plan
        Depth: 5
        Durability Policy: Volatile
        Reliability Policy: Reliable
    - Class: rviz_default_plugins/Path
      Name: robot3 plan
      Enabled: true
      Color: 80; 120; 255
      Topic:
        Value: /robot3/plan
        Depth: 5
        Durability Policy: Volatile
        Reliability Policy: Reliable
    - Class: rviz_default_plugins/Marker
      Name: robot1 battery
      Enabled: true
      Topic:
        Value: /robot1/battery_marker
        Depth: 1
        Durability Policy: Volatile
        Reliability Policy: Reliable
    - Class: rviz_default_plugins/MarkerArray
      Name: robot1 charging zones
      Enabled: true
      Topic:
        Value: /robot1/charging_zones
        Depth: 1
        Durability Policy: Transient Local
        Reliability Policy: Reliable
    - Class: rviz_default_plugins/Image
      Name: robot1 camera
      Enabled: true
      Topic:
        Value: /robot1/image_raw
        Depth: 1
        Durability Policy: Volatile
        Reliability Policy: Reliable
    - Class: rviz_default_plugins/TF
      Name: TF
      Enabled: false
      Show Names: true
  Global Options:
    Background Color: 46; 52; 54
    Fixed Frame: map
    Frame Rate: 30
  Views:
    Current:
      Class: rviz_default_plugins/TopDownOrtho
      Name: TopDown
      Scale: 60
      Target Frame: <Fixed Frame>
      X: 4
      Y: 2
Window Geometry:
  Height: 1000
  Width: 1400
