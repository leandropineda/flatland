# Per-robot navigation container: nav2 + slam_toolbox from apt, nothing built.
#   docker build -f Dockerfile.nav2 --build-arg ROS_DISTRO=jazzy -t fleet-nav2:jazzy .
ARG ROS_DISTRO=jazzy

# --- builder: the EventsExecutor component container (see container/) ---
# The stock waitset containers burn idle CPU waking on the 50 Hz sim clock.
FROM ros:${ROS_DISTRO}-ros-base AS builder
ARG ROS_DISTRO
ENV DEBIAN_FRONTEND=noninteractive
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential cmake python3-colcon-common-extensions \
    ros-${ROS_DISTRO}-ament-cmake && rm -rf /var/lib/apt/lists/*
COPY container/ /src/container/
RUN . /opt/ros/${ROS_DISTRO}/setup.sh && \
    colcon --log-base /tmp/log build --base-paths /src/container \
      --build-base /tmp/build --merge-install \
      --install-base /opt/fleet_container \
      --cmake-args -DCMAKE_BUILD_TYPE=Release

# --- runtime ---
FROM ros:${ROS_DISTRO}-ros-base
ARG ROS_DISTRO
ENV DEBIAN_FRONTEND=noninteractive
COPY --from=builder /opt/fleet_container /opt/fleet_container
# sourcing /opt/ros later PREPENDS, so the extra prefix survives
ENV AMENT_PREFIX_PATH=/opt/fleet_container

RUN apt-get update && apt-get install -y --no-install-recommends \
    ros-${ROS_DISTRO}-nav2-controller \
    ros-${ROS_DISTRO}-nav2-planner \
    ros-${ROS_DISTRO}-nav2-behaviors \
    ros-${ROS_DISTRO}-nav2-bt-navigator \
    ros-${ROS_DISTRO}-nav2-lifecycle-manager \
    ros-${ROS_DISTRO}-nav2-map-server \
    ros-${ROS_DISTRO}-nav2-amcl \
    ros-${ROS_DISTRO}-nav2-dwb-controller \
    ros-${ROS_DISTRO}-nav2-navfn-planner \
    ros-${ROS_DISTRO}-slam-toolbox \
    ros-${ROS_DISTRO}-rmw-cyclonedds-cpp \
    && rm -rf /var/lib/apt/lists/*

COPY nav2/ /fleet/nav2/
